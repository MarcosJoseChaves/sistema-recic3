APP_ENV=development
APP_DEBUG=false
SECRET_KEY=
DATABASE_URL=
# Em ambiente online, use somente o proxy reverso previsto.
TRUST_PROXY=false
# Informe hosts exatos, sem protocolo, caminho, porta ou curingas.
TRUSTED_HOSTS=localhost,127.0.0.1,::1
# Limite global inteiro em MB; ambientes online exigem valor explícito.
MAX_REQUEST_MB=64
# CSP ativa por padrão; modo somente relatório é proibido em produção.
CSP_REPORT_ONLY=false
# Logs da aplicação: JSON é obrigatório em homologação e produção.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REQUESTS=true
LOG_SECURITY_EVENTS=true
# O limitador é obrigatório em ambientes online.
RATELIMIT_ENABLED=true
# Use memory:// somente localmente ou na primeira homologação restrita e aceita.
# Produção exige armazenamento Redis compartilhado configurado fora do Git.
RATELIMIT_STORAGE_URI=memory://
# Exigida como true para autorizar memory:// somente na homologação restrita.
RATELIMIT_ALLOW_MEMORY_HOMOLOGATION=false
RATELIMIT_DEFAULT=300 per minute
RATELIMIT_LOGIN=5 per minute
RATELIMIT_REPORTS=10 per minute
RATELIMIT_EXTERNAL_LOOKUPS=30 per minute
RATELIMIT_UPLOADS=10 per minute
RATELIMIT_MUTATIONS=60 per minute
RATELIMIT_DOWNLOADS=30 per minute
HOMOLOGATION_GATE_ENABLED=false
HOMOLOGATION_GATE_USER=
HOMOLOGATION_GATE_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=desenvolvimento/fiscalizacao-contratos
# Limite individual dos documentos do módulo.
FC_MAX_UPLOAD_MB=20
# PORT é fornecida pela plataforma online.
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
